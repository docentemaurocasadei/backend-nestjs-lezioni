docker run --name wordpressdb --network wpnet -e MYSQL_DATABASE=wordpress -e MYSQL_USER=wp_user -e MYSQL_PASSWORD=wp_pass -e MYSQL_ROOT_PASSWORD=root_pass -d mysql:5.7

